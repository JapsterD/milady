# Copy to /opt/milady-deploy.env on the VPS and chmod 600.
# Reference from systemd: EnvironmentFile=-/opt/milady-deploy.env

# API
MILADY_API_BIND=0.0.0.0
MILADY_API_TOKEN=change-me

# If MILADY_API_BIND is not 0.0.0.0, browsers must send a matching Host header.
# Comma-separated hostnames (no scheme), e.g. milady.example.com,203.0.113.10
# MILADY_ALLOWED_HOSTS=milady.example.com

# Behind a path prefix only (rare): set API base for injected dashboard script
# ELIZA_EXTERNAL_BASE_URL=https://example.com/milady

# With MILADY_API_TOKEN set, NODE_ENV is forced to production for the dashboard unless:
# MILADY_FORCE_ELIZA_PRODUCTION_UI=0

# If system Bun is 1.3.x and crashes on this CPU, install Bun 1.2.22 and set:
# MILADY_BUN_BIN=/root/.bun/bin/bun

# Models (set at least one)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

LOG_LEVEL=info

# Skip auto sharp rebuild during `bun install` (e.g. CI without libvips):
# MILADY_SKIP_LOWCPU_SHARP_REBUILD=1
