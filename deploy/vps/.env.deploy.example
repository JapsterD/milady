# Copy to .env.deploy (gitignored) and fill in. Prefer SSH keys: ssh-copy-id -p 22 root@YOUR_IP
export MILADY_VPS_HOST=root@YOUR_IP
export MILADY_VPS_SSH_PORT=22
# Optional — requires `sshpass` (e.g. brew install sshpass). Omit if you use pubkey auth.
# export MILADY_VPS_PASSWORD='your-password'

export MILADY_VPS_PATH=/opt/milady
export MILADY_VPS_SERVICE=milady
